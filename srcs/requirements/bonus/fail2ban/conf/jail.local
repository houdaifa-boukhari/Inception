[vsftpd]
enabled = true
port = ftp
filter = vsftpd
logpath = /var/log/vsftpd/vsftpd.log
maxretry = 3
findtime = 600
bantime = 3600
action   = iptables-docker[name=vsftpd]

[wordpress]
enabled = true
filter = wordpress
action = iptables[name=WordPress, port=http, protocol=tcp]
logpath = /var/log/nginx/access.log
maxretry = 3
findtime = 600
bantime = 3600

[sshd]
enabled = false
